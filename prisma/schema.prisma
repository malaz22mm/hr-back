generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model Users {
  id                         String             @id @default(uuid())
  name                       String
  role                       UserRole           @default(ADMIN)
  approvalState              ApprState          @default(NOT_VERIFIED)
  verificationCode           Int?
  verificationCode_ExpiresAt DateTime?
  email                      String             @unique @db.VarChar(255)
  phone                      String?            @unique @db.VarChar(50)
  hashedPassword             String
  hashedRefreshToken         String?
  hashedAccessToken          String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  processed_vacations        Vacation_Request[]

  // New relation fields
  employee_id Int?       @unique
  employee    Employees? @relation(fields: [employee_id], references: [id])
}

model Employees {
  id                           Int     @id @default(autoincrement())
  name                         String
  name_code                    String
  attrition                    Boolean
  age                          Int
  gender                       Boolean // true for men
  health_status                String?
  distance_from_home           Int
  hourly_rate                  Int
  daily_rate                   Int
  monthly_rate                 Int
  monthly_income               Int
  percent_salary_hike          Int
  job_level                    Int
  num_of_companies_worked      Int
  total_working_years          Int
  training_times_last_year     Int
  years_at_company             Int
  years_in_current_role        Int
  years_since_last_promotion   Int
  years_with_curr_manager      Int
  stock_option_level           Int
  over_time                    Boolean
  workload_pressure_index      Int
  engagement_score             Int
  engagement_feedback_score    Int
  training_hours_last_year     Int
  training_hours_last_6_months Int
  training_gap_score           Int
  promotion_stagnation_ratio   Float
  role_stability_ratio         Float

  // Foreign Keys
  marital_status_id            Int
  health_state_id              Int
  job_role_id                  Int
  business_travel_id           Int
  department_id                Int
  education_id                 Int
  performance_rating_id        Int
  attrition_risk_class_id      Int
  environment_satisfaction_id  Int
  job_involvement_id           Int
  job_satisfaction_id          Int
  relationship_satisfaction_id Int
  work_life_balance_id         Int
  work_shift_id                Int

  // Relations
  MaritalStatus           MaritalStatus      @relation(fields: [marital_status_id], references: [id])
  HealthState             HealthState        @relation(fields: [health_state_id], references: [id])
  JobRole                 JobRoleType        @relation(fields: [job_role_id], references: [id])
  BusinessTravel          BusinessTravel     @relation(fields: [business_travel_id], references: [id])
  Department              DepartmentType     @relation(fields: [department_id], references: [id])
  Education               Education          @relation(fields: [education_id], references: [id])
  PerformanceRating       PerformanceRating  @relation(fields: [performance_rating_id], references: [id])
  AttritionRiskClass      AttritionRiskClass @relation(fields: [attrition_risk_class_id], references: [id])
  EnvironmentSatisfaction Satisfaction       @relation("EnvSat", fields: [environment_satisfaction_id], references: [id])
  JobInvolvement          Satisfaction       @relation("JobInv", fields: [job_involvement_id], references: [id])
  JobSatisfaction         Satisfaction       @relation("JobSat", fields: [job_satisfaction_id], references: [id])
  RelationshipSat         Satisfaction       @relation("RelSat", fields: [relationship_satisfaction_id], references: [id])
  WorkLifeBalance         Satisfaction       @relation("WLB", fields: [work_life_balance_id], references: [id])
  Vacation_Requests       Vacation_Request[]
  Attendance_Logs         Attendance_Logs[]
  WorkShift               WorkShift          @relation(fields: [work_shift_id], references: [id])
  User                    Users?
}

model MaritalStatus {
  id        Int         @id
  name      String
  name_code String
  Employees Employees[]
}

model BusinessTravel {
  id        Int         @id
  name      String
  name_code String
  Employees Employees[]
}

model DepartmentType {
  id        Int         @id
  name      String
  name_code String
  Employees Employees[]
}

model HealthState {
  id        Int         @id
  name      String
  name_code String
  Employees Employees[]
}

model Education {
  id        Int         @id
  name      String
  name_code String
  Employees Employees[]
}

model Satisfaction {
  id        Int    @id
  name      String
  name_code String

  EnvSatEmployees Employees[] @relation("EnvSat")
  JobInvEmployees Employees[] @relation("JobInv")
  JobSatEmployees Employees[] @relation("JobSat")
  RelSatEmployees Employees[] @relation("RelSat")
  WLBEmployees    Employees[] @relation("WLB")
}

model JobRoleType {
  id        Int         @id
  name      String
  name_code String
  Employees Employees[]
}

model PerformanceRating {
  id        Int         @id
  name      String
  name_code String
  Employees Employees[]
}

model AttritionRiskClass {
  id        Int         @id
  name      String
  name_code String
  Employees Employees[]
}

model RequestStatus {
  id                Int                @id
  name              String
  Vacation_Requests Vacation_Request[]
}

model Vacation_Request {
  id              Int       @id @default(autoincrement())
  emp_id          Int
  processed_by    String?
  processed_at    DateTime?
  requested_at    DateTime  @default(now())
  start_date      DateTime  @db.Date
  end_date        DateTime  @db.Date
  reason          String
  approval_status Int

  Employee      Employees     @relation(fields: [emp_id], references: [id])
  Processor     Users?        @relation(fields: [processed_by], references: [id])
  RequestStatus RequestStatus @relation(fields: [approval_status], references: [id])
}

model WorkShift {
  id                   Int               @id @default(autoincrement())
  shift_name           String
  start_time           DateTime
  end_time             DateTime
  grace_period_minutes Int
  Attendance_Logs      Attendance_Logs[]
  Employees            Employees[]
}

model Attendance_Logs {
  id        Int       @id @default(autoincrement())
  emp_id    Int
  check_in  DateTime
  check_out DateTime?
  shift_id  Int

  Employee  Employees @relation(fields: [emp_id], references: [id])
  WorkShift WorkShift @relation(fields: [shift_id], references: [id])
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
  EMPLOYEE
}

enum ApprState {
  VERIFIED
  NOT_VERIFIED
}
