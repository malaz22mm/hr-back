# Application
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_with_a_local_password
DB_DATABASE=hr_analytics

# JWT signing secrets
AT_SECRET=replace_with_a_long_random_access_token_secret
RT_SECRET=replace_with_a_different_long_random_refresh_token_secret

# SMTP (required for verification and password-recovery emails)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=replace_with_an_app_password
